# Backend Environment Variables
DATABASE_URL=sqlite+aiosqlite:///./interview_agent.db
BREETH_API_KEY=your_breeth_api_key_here
BREETH_BASE_URL=https://api.thebreeth.com
JWT_SECRET=generate_a_strong_random_secret_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ENCRYPTION_KEY=generate_a_strong_encryption_key_for_2fa

# Database Default Administrator Credentials
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=changeme

# Frontend Environment Variables (if Next.js uses them)
NEXT_PUBLIC_API_URL=http://localhost:8000
